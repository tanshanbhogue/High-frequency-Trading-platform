# =====================================================================
# Environment variables template.
#   cp .env.example .env     (then edit .env; .env is git-ignored)
# The MySQL passwords MUST match sql/03_roles_and_grants.sql.
# =====================================================================

# --- MySQL (one login per database role) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=HFT

MYSQL_ADMIN_USER=hft_admin_user
MYSQL_ADMIN_PASSWORD=AdminPass#2026

MYSQL_TRADER_USER=hft_trader_user
MYSQL_TRADER_PASSWORD=TraderPass#2026

MYSQL_AUDITOR_USER=hft_auditor_user
MYSQL_AUDITOR_PASSWORD=AuditorPass#2026

MYSQL_AUTH_USER=hft_auth_user
MYSQL_AUTH_PASSWORD=AuthPass#2026

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=HFT_docs

# --- Web app session signing (change this to any long random string) ---
JWT_SECRET=qYRAYxLBS0NIZo17bvbEWc2zVNMjtpd4XqokZir4M
JWT_EXPIRES_IN=8h
